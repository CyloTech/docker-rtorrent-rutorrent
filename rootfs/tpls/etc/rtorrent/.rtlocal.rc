# Launch as a daemon
system.daemon.set = true

# Instance layout
method.insert = cfg.basedir, private|const|string, (cat,"/torrents/config/rtorrent/")
method.insert = cfg.download, private|const|string, (cat,"/torrents/")
method.insert = cfg.download_complete, private|const|string, (cat,(cfg.download),"completed/")
method.insert = cfg.download_temp, private|const|string, (cat,(cfg.download),"downloading/")
method.insert = cfg.logs, private|const|string, (cat,(cfg.basedir),"log/")
# Session directory - check for old 'session' dir first for backwards compatibility
# If /torrents/config/rtorrent/session exists and has files, use it; otherwise use .session
method.insert = cfg.session, private|const|string, (cat,(cfg.basedir),".session/")
method.insert = cfg.watch, private|const|string, (cat,(cfg.download),"watch/")
method.insert = cfg.rundir, private|const|string, (cat,"/var/run/rtorrent/")

# Gets the full path of data of a torrent (it's a workaround for the possibly empty 'd.base_path' attribute)
method.insert = d.data_path, simple, "if=(d.is_multi_file), (cat,(d.directory),/), (cat,(d.directory),/,(d.name))"

# Default directory to save the downloaded torrents
directory.default.set = (cat,(cfg.download_temp))

# Default session directory
session.path.set = (cat,(cfg.session))

# PID file
execute.nothrow = sh,-c,(cat,"echo >",(cfg.rundir),"rtorrent.pid"," ",(system.pid))

# Bind address
# FIXME: remove once https://github.com/rakshasa/rtorrent/issues/1569 is fixed
network.bind_address.set = 0.0.0.0

# SCGI socket and make it group-writable and secure
network.scgi.open_local = (cat, (cfg.rundir), "scgi.socket")
schedule = scgi_permission, 0, 0, (cat,"execute.nothrow=chmod,\"g+w,o=\",",(cfg.rundir),"scgi.socket")

# Listening port for incoming peer traffic
network.listen.port.range.set = @RT_INC_PORT@-@RT_INC_PORT@
network.listen.port.random.set = no

# UDP port to use for DHT
dht.override_port.set = @RT_DHT_PORT@

# XMLRPC size limit
network.xmlrpc.size_limit.set = @XMLRPC_SIZE_LIMIT@

# Save after the first minute, then every five minutes by default.
# A separate name keeps an older custom session_save timer from replacing this one.
schedule = appbox_session_save, 60, @RT_SESSION_SAVE_SECONDS@, ((session.save))

# Queue a final snapshot before shutdown waits for tracker/network cleanup.
method.set_key = event.system.shutdown, appbox_session_save, ((session.save))

# rTorrent's built-in ~_save_full handler saves newly inserted torrents.

# Configure whether to delay tracker announces at startup
trackers.delay_scrape = @RT_TRACKER_DELAY_SCRAPE@

# Zero skips explicit socket buffer options and preserves kernel TCP autotuning.
network.send_buffer.size.set = @RT_SEND_BUFFER_SIZE@
network.receive_buffer.size.set = @RT_RECEIVE_BUFFER_SIZE@

# Preallocation: 0 disables it; 1 enables allocation as each file is opened for writing.
system.file.allocate.set = @RT_PREALLOCATE_TYPE@

# Logging
## levels = critical error warn notice info debug
## groups = connection_* dht_* peer_* rpc_* storage_* thread_* tracker_* torrent_*
log.open_file = "log",(cat,(cfg.logs),"rtorrent.log")
log.add_output = "@RT_LOG_LEVEL@","log"
log.add_output = "rpc_events","log"
#log.execute = (cat,(cfg.logs),"execute.log")
#log.xmlrpc = (cat,(cfg.logs),"xmlrpc.log")

# Initialize plugins after a 10 seconds delay
schedule = init_plugins, 10, 0, "execute = {sh,-c,/usr/bin/php85 /var/www/rutorrent/php/initplugins.php @RUTORRENT_USER@ &}"

# Let rTorrent validate its saved resume state. Zero progress alone does not
# justify forcing a torrent into the hash-check queue on every restart.
