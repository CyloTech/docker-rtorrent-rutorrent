# ruTorrent 5.3.15.5: the published 5.3.15.4 image with only its php85
# packages upgraded to 8.5.12 for the PHP security release of 21 October 2026
# (multipart/form-data parsing).
#
# 5.3.15.4 was built from commit f06eb117225f40e69c4d8f23c08cf9a3df22494f
# (RELEASE-5.3.15.4.md). Starting from its immutable digest keeps rTorrent,
# libtorrent, ruTorrent, the plugins, rootfs, configuration and every other
# Alpine package exactly as deployed. A full rebuild of Dockerfile would also
# pull in unpinned plugin, pip, cpan and GeoIP changes.
#
# Alpine's v3.24 index did not have php85 8.5.12 yet, so the packages come
# from our own build of Alpine's community/php85 APKBUILD, published as the
# package artifact image PHP85_ARTIFACT (release/php85-artifact/README.md).
# The upgrade uses only that signed repository (no network, its own key
# directory), so nothing besides the installed php85 packages can change,
# and the key is never added to /etc/apk/keys. The artifact is bind-mounted
# for the one RUN, so the image is the 5.3.15.4 layers plus one.
# release/verify-image.sh is the release gate for this image.
#
# Release build (dedicated builder, from the exact pushed commit):
#   docker build --pull --no-cache --platform linux/amd64 \
#     -f Dockerfile.php-security -t repo.cylo.net/rutorrent:5.3.15.5-0.16.24 .

ARG PHP85_ARTIFACT=repo.cylo.net/php-artifacts@sha256:c810e2dbf5e5ff8225acc76d816fc76a00495430e9344ccf14acc632d2ad371d
ARG PHP85_PACKAGE_VERSION=8.5.12-r0

FROM ${PHP85_ARTIFACT} AS php85-artifact

FROM repo.cylo.net/rutorrent@sha256:d0d5e6f7577aef143f171f4d05995c045122380311396694b430ec758947d5ee

ARG PHP85_ARTIFACT
ARG PHP85_PACKAGE_VERSION
LABEL io.appbox.rutorrent.base-image="repo.cylo.net/rutorrent@sha256:d0d5e6f7577aef143f171f4d05995c045122380311396694b430ec758947d5ee" \
      io.appbox.php85-artifact="${PHP85_ARTIFACT}"

# Upgrade only the installed php85 packages from the artifact repository,
# then fail unless every one of them is PHP85_PACKAGE_VERSION, PHP reports
# the matching version and the FPM configuration still loads.
RUN --mount=type=bind,from=php85-artifact,source=/,target=/run/php85-artifact \
    set -eu; \
    case "$PHP85_ARTIFACT" in \
        repo.cylo.net/php-artifacts@sha256:????????????????????????????????????????????????????????????????) ;; \
        *) echo "PHP85_ARTIFACT must be a pinned digest: $PHP85_ARTIFACT" >&2; exit 1 ;; \
    esac; \
    case "$PHP85_PACKAGE_VERSION" in \
        [0-9]*.[0-9]*.[0-9]*-r[0-9]*) ;; \
        *) echo "Invalid PHP85_PACKAGE_VERSION: $PHP85_PACKAGE_VERSION" >&2; exit 1 ;; \
    esac; \
    artifact=/run/php85-artifact; \
    (cd "$artifact" && sha256sum -c SHA256SUMS >/dev/null); \
    php85_packages="$(apk info 2>/dev/null | grep -E '^php85(-|$)' | sort)"; \
    test -n "$php85_packages"; \
    apk --no-cache --no-network --repositories-file /dev/null \
        --repository "$artifact/packages/community" --keys-dir "$artifact/keys" \
        upgrade $php85_packages; \
    test "$(apk info 2>/dev/null | grep -E '^php85(-|$)' | sort)" = "$php85_packages"; \
    php85_builds="$(apk info -v 2>/dev/null | grep -E '^php85(-[a-z0-9]+)*-[0-9]' | sed -E 's/^php85(-[a-z0-9]+)*-//' | sort -u)"; \
    test "$php85_builds" = "$PHP85_PACKAGE_VERSION"; \
    php85_version="${PHP85_PACKAGE_VERSION%-r*}"; \
    test "$(php85 -r 'echo PHP_VERSION;')" = "$php85_version"; \
    test "$(php-fpm85 -v | head -n 1 | awk '{print $2}')" = "$php85_version"; \
    php-fpm85 -t; \
    echo "php85 $php85_builds from $PHP85_ARTIFACT"
